#[test]
fn test_grad_linear_regression_closed_form() is
    let w: tensor::Tensor = tensor::param([2.0, 3.0], [2, 1], 0)
    let b: tensor::Tensor = tensor::param([0.5], [1], 1)
    let x: tensor::Tensor = tensor::from_rows([[1.0, 2.0], [3.0, 4.0]])
    let y: tensor::Tensor = tensor::from_rows([[1.0], [2.0]])
    let loss: tensor::Tensor = functional::mse_loss(x.matmul(w).add(b), y)
    assert_approx(loss.item(), 164.25, 0.000001)
    let g: [tensor::Tensor] = autograd::backward(loss, [w, b])
    assert_approx(g[0].data[0], 57.0, 0.000001)
    assert_approx(g[0].data[1], 81.0, 0.000001)
    assert_approx(g[1].data[0], 24.0, 0.000001)
end

#[test]
fn test_grad_shared_parameter_accumulates() is
    ;; loss = sum(w*w) + sum(w) -> d/dw = 2w + 1
    let w: tensor::Tensor = tensor::param([1.0, -2.0], [2], 0)
    let loss: tensor::Tensor = tensor::add(tensor::sum(tensor::mul(w, w)), tensor::sum(w))
    let g: [tensor::Tensor] = autograd::backward(loss, [w])
    assert_approx(g[0].data[0], 3.0, 0.000001)
    assert_approx(g[0].data[1], -3.0, 0.000001)
end

#[test]
fn test_detach_blocks_gradient() is
    let w: tensor::Tensor = tensor::param([2.0], [1], 0)
    let loss: tensor::Tensor = tensor::sum(tensor::mul(tensor::detach(w), w))
    let g: [tensor::Tensor] = autograd::backward(loss, [w])
    ;; only the second factor is tracked: d/dw (c * w) = c = 2
    assert_approx(g[0].data[0], 2.0, 0.000001)
end

#[test]
fn test_unused_parameter_gets_zero_gradient() is
    let a: tensor::Tensor = tensor::param([1.0], [1], 0)
    let b: tensor::Tensor = tensor::param([5.0], [1], 1)
    let g: [tensor::Tensor] = autograd::backward(tensor::sum(tensor::mul(a, a)), [a, b])
    assert_approx(g[0].data[0], 2.0, 0.000001)
    assert_approx(g[1].data[0], 0.0, 0.000001)
end

#[test]
fn test_constants_record_no_graph() is
    let a: tensor::Tensor = tensor::from_vec([1.0, 2.0], [2])
    let c: tensor::Tensor = tensor::exp(tensor::add(a, a))
    assert_eq(c.op, 0)
    assert_eq(c.leaf, -1)
end
