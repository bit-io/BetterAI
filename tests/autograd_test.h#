using "2026"
use "bit -> betterai"
use "std -> test" from "test"

;; Gradient check: compare the analytic gradient of autograd::backward with central
;; finite differences for every element of x, for a loss built from many ops.

fn side_w() -> tensor::Tensor is
    return tensor::from_rows([[0.5, -1.0], [0.25, 2.0], [-0.75, 1.5]])
end

fn side_v() -> tensor::Tensor is
    return tensor::vector([1.0, -2.0, 0.5])
end

fn side_c() -> tensor::Tensor is
    return tensor::from_rows([[1.0, 2.0, 3.0], [-1.0, 0.5, 2.0]])
end

;; x has shape [2, 3]
fn build(kase: int, x: tensor::Tensor) -> tensor::Tensor is
    if kase == 0 is
        return tensor::sum(tensor::mul(tensor::add(x, side_v()), tensor::sub(x, tensor::scalar(0.5))))
    elsif kase == 1 is
        return tensor::sum(tensor::div(x, tensor::add_scalar(tensor::mul(x, x), 1.0)))
    elsif kase == 2 is
        return tensor::sum(tensor::tanh(tensor::matmul(x, side_w())))
    elsif kase == 3 is
        return tensor::sum(tensor::mul(tensor::transpose(x), tensor::transpose(side_c())))
    elsif kase == 4 is
        return tensor::mean(tensor::sigmoid(x))
    elsif kase == 5 is
        return tensor::sum(tensor::log(tensor::add_scalar(tensor::exp(x), 1.0)))
    elsif kase == 6 is
        return tensor::sum(tensor::sqrt(tensor::add_scalar(tensor::pow(x, 2.0), 1.0)))
    elsif kase == 7 is
        return tensor::sum(tensor::mul(tensor::softmax(x), side_c()))
    elsif kase == 8 is
        return tensor::nll(tensor::log_softmax(x), [0, 2])
    elsif kase == 9 is
        let a: tensor::Tensor = tensor::mul(tensor::sum_axis(x, 0, false), side_v())
        let b: tensor::Tensor = tensor::mul(tensor::mean_axis(x, 1, true), tensor::from_rows([[2.0], [-3.0]]))
        return tensor::add(tensor::sum(a), tensor::sum(b))
    elsif kase == 10 is
        let a: tensor::Tensor = tensor::mul(tensor::leaky_relu(x, 0.1), x)
        return tensor::add(tensor::sum(a), tensor::sum(tensor::add(tensor::abs(x), tensor::clamp(x, -0.5, 0.5))))
    elsif kase == 11 is
        return tensor::sum(tensor::mul(functional::normalize(x, 0.00001), side_c()))
    elsif kase == 12 is
        let t: tensor::Tensor = tensor::from_rows([[1.0, 0.0, 1.0], [0.0, 1.0, 0.0]])
        return tensor::add(functional::bce_with_logits(x, t), functional::huber_loss(tensor::mul_scalar(x, 3.0), t))
    elsif kase == 13 is
        return tensor::sum(tensor::reshape(tensor::relu(tensor::neg(x)), [3, 2]))
    end
    return functional::cross_entropy(tensor::reshape(x, [2, 3]), [1, 0])
end

fn check(kase: int) is
    let x0: tensor::Tensor = tensor::param([0.3, -0.7, 1.1, 0.9, -1.3, 0.4], [2, 3], 0)
    let g: [tensor::Tensor] = autograd::backward(build(kase, x0), [x0])
    let mut i: int = 0
    while i < 6 is
        let hi: f64 = build(kase, autograd::perturbed(x0, i, 0.00001)).data[0]
        let lo: f64 = build(kase, autograd::perturbed(x0, i, -0.00001)).data[0]
        let numeric: f64 = (hi - lo) / 0.00002
        assert_approx(g[0].data[i], numeric, 0.0001)
        i += 1
    end
end

