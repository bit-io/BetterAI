;; ── metrics ─────────────────────────────────────────────────────────────────

;; fraction of rows whose arg-max equals the target class
pub fn accuracy(logits: tensor::Tensor, targets: [int]) -> f64 is
    let pred: [int] = tensor::argmax_rows(logits)
    let mut hit: int = 0
    let mut i: int = 0
    while i < pred.len() is
        if pred[i] == targets[i] is
            hit += 1
        end
        i += 1
    end
    return (hit as f64) / (pred.len() as f64)
end

;; accuracy of binary predictions: `out` are probabilities (threshold 0.5) or,
;; with from_logits = true, raw logits (threshold 0)
pub fn binary_accuracy(out: tensor::Tensor, y: tensor::Tensor, from_logits: bool) -> f64 is
    let cut: f64 = if from_logits then 0.0 else 0.5 end
    let mut hit: int = 0
    let mut i: int = 0
    while i < out.data.len() is
        let p: f64 = if out.data[i] > cut then 1.0 else 0.0 end
        if p == y.data[i] is
            hit += 1
        end
        i += 1
    end
    return (hit as f64) / (out.data.len() as f64)
end

;; coefficient of determination
pub fn r2_score(pred: tensor::Tensor, target: tensor::Tensor) -> f64 is
    let n: f64 = target.data.len() as f64
    let mut mu: f64 = 0.0
    for v in target.data is
        mu += v
    end
    mu = mu / n
    let mut ss_res: f64 = 0.0
    let mut ss_tot: f64 = 0.0
    let mut i: int = 0
    while i < target.data.len() is
        ss_res += (target.data[i] - pred.data[i]) * (target.data[i] - pred.data[i])
        ss_tot += (target.data[i] - mu) * (target.data[i] - mu)
        i += 1
    end
    return 1.0 - ss_res / ss_tot
end

;; ── gradients ───────────────────────────────────────────────────────────────

;; global L2 norm of a list of gradients
pub fn grad_norm(grads: [tensor::Tensor]) -> f64 is
    let mut s: f64 = 0.0
    for g in grads is
        for v in g.data is
            s += v * v
        end
    end
    return math::sqrt(s)
end

;; rescale the gradients so that their global norm is at most `max_norm`
pub fn clip_grad_norm(grads: [tensor::Tensor], max_norm: f64) -> [tensor::Tensor] is
    let n: f64 = grad_norm(grads)
    if n <= max_norm || n == 0.0 is
        return grads
    end
    let c: f64 = max_norm / (n + 0.000001)
    let mut out: [tensor::Tensor] = []
    for g in grads is
        out.push(tensor::mul_scalar(g, c))
    end
    return out
end

;; ── one training step: forward, loss, backward, optimizer ──────────────────

pub struct TrainStep is
    pub model: nn::Module
    pub opt: optim::Optimizer
    pub loss: f64
end

;; loss kinds: 0 mse   1 cross_entropy (y = class ids)   2 bce_with_logits
;;             3 l1    4 huber                            5 bce (y = 0/1, model ends in sigmoid)
pub fn loss_value(kind: int, out: tensor::Tensor, y: tensor::Tensor) -> tensor::Tensor is
    if kind == 0 is
        return functional::mse_loss(out, y)
    elsif kind == 1 is
        return functional::cross_entropy(out, data::labels(y))
    elsif kind == 2 is
        return functional::bce_with_logits(out, y)
    elsif kind == 3 is
        return functional::l1_loss(out, y)
    elsif kind == 4 is
        return functional::huber_loss(out, y)
    end
    return functional::bce_loss(out, y)
end

;; PyTorch's  optimizer.zero_grad(); loss = crit(model(x), y); loss.backward(); optimizer.step()
pub fn train_step(model: nn::Module, opt: optim::Optimizer, x: tensor::Tensor, y: tensor::Tensor, loss_kind: int, seed: int) -> TrainStep is
    let out: tensor::Tensor = nn::forward_seeded(nn::train(model), x, seed)
    let loss: tensor::Tensor = loss_value(loss_kind, out, y)
    let grads: [tensor::Tensor] = autograd::backward(loss, nn::parameters(model))
    let r: optim::StepResult = optim::step(opt, model, grads)
    return TrainStep { model: r.model, opt: r.opt, loss: loss.data[0] }
end

;; mean loss of a model over a dataset, in eval mode and without building graphs
pub fn evaluate(model: nn::Module, ds: data::Dataset, loss_kind: int) -> f64 is
    let out: tensor::Tensor = nn::predict(model, ds.x)
    return loss_value(loss_kind, out, ds.y).data[0]
end

;; ── saving and loading weights (plain text) ─────────────────────────────────
;;   one line per parameter:  <shape, comma separated>;<values, comma separated>

fn join_f(v: [f64]) -> string is
    let mut s: string = ""
    let mut i: int = 0
    while i < v.len() is
        if i > 0 is
            s = s + ","
        end
        s = s + to_string(v[i])
        i += 1
    end
    return s
end

fn join_i(v: [int]) -> string is
    let mut s: string = ""
    let mut i: int = 0
    while i < v.len() is
        if i > 0 is
            s = s + ","
        end
        s = s + to_string(v[i])
        i += 1
    end
    return s
end

pub fn params_to_string(model: nn::Module) -> string is
    let mut s: string = "betterai-weights 1\n"
    for p in nn::parameters(model) is
        s = s + join_i(p.shape) + ";" + join_f(p.data) + "\n"
    end
    return s
end

;; returns a copy of `model` with the weights stored in `text`
pub fn params_from_string(model: nn::Module, text: string) -> nn::Module is
    let lines: [string] = text.split("\n")
    if lines.len() == 0 || lines[0] != "betterai-weights 1" is
        panic("betterai: not a BetterAI weights file")
    end
    let current: [tensor::Tensor] = nn::parameters(model)
    let mut ps: [tensor::Tensor] = []
    let mut k: int = 0
    while k < current.len() is
        let line: string = lines[k + 1]
        let halves: [string] = line.split(";")
        let mut vals: [f64] = []
        if halves[1].len() > 0 is
            for tok in halves[1].split(",") is
                vals.push(conv::str_to_float(tok))
            end
        end
        if vals.len() != current[k].data.len() is
            panic("betterai: weights file does not match the model (parameter " + to_string(k) + ")")
        end
        ps.push(tensor::from_vec(vals, current[k].shape))
        k += 1
    end
    return nn::with_parameters(model, ps)
end

pub fn save_params(path: string, model: nn::Module) is
    fs::write(path, params_to_string(model))
end

pub fn load_params(path: string, model: nn::Module) -> nn::Module is
    return params_from_string(model, fs::read(path))
end
